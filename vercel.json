{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web && node site/build.mjs",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/landing.html", "destination": "/", "permanent": true },
    { "source": "/guides", "destination": "/guides/", "permanent": true },
    { "source": "/a-propos", "destination": "/a-propos/", "permanent": true },
    { "source": "/contact", "destination": "/contact/", "permanent": true },
    { "source": "/en", "destination": "/en/", "permanent": true },
    { "source": "/en/guides", "destination": "/en/guides/", "permanent": true },
    { "source": "/es", "destination": "/es/", "permanent": true },
    { "source": "/pt", "destination": "/pt/", "permanent": true },
    { "source": "/de", "destination": "/de/", "permanent": true },
    { "source": "/it", "destination": "/it/", "permanent": true },
    { "source": "/ru", "destination": "/ru/", "permanent": true },
    { "source": "/tr", "destination": "/tr/", "permanent": true },
    { "source": "/pl", "destination": "/pl/", "permanent": true },
    { "source": "/nl", "destination": "/nl/", "permanent": true },
    { "source": "/id", "destination": "/id/", "permanent": true },
    { "source": "/vi", "destination": "/vi/", "permanent": true },
    { "source": "/th", "destination": "/th/", "permanent": true },
    { "source": "/uk", "destination": "/uk/", "permanent": true },
    { "source": "/ro", "destination": "/ro/", "permanent": true },
    { "source": "/el", "destination": "/el/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/ph/static/(.*)", "destination": "https://eu-assets.i.posthog.com/static/$1" },
    { "source": "/ph/(.*)", "destination": "https://eu.i.posthog.com/$1" },
    { "source": "/play", "destination": "/app.html" },
    { "source": "/play/", "destination": "/app.html" },
    { "source": "/daily", "destination": "/app.html" },
    { "source": "/daily/", "destination": "/app.html" },
    { "source": "/en/play", "destination": "/app-en.html" },
    { "source": "/en/play/", "destination": "/app-en.html" },
    { "source": "/es/play", "destination": "/app-es.html" },
    { "source": "/es/play/", "destination": "/app-es.html" },
    { "source": "/pt/play", "destination": "/app-pt.html" },
    { "source": "/pt/play/", "destination": "/app-pt.html" },
    { "source": "/de/play", "destination": "/app-de.html" },
    { "source": "/de/play/", "destination": "/app-de.html" },
    { "source": "/it/play", "destination": "/app-it.html" },
    { "source": "/it/play/", "destination": "/app-it.html" },
    { "source": "/ru/play", "destination": "/app-ru.html" },
    { "source": "/ru/play/", "destination": "/app-ru.html" },
    { "source": "/tr/play", "destination": "/app-tr.html" },
    { "source": "/tr/play/", "destination": "/app-tr.html" },
    { "source": "/pl/play", "destination": "/app-pl.html" },
    { "source": "/pl/play/", "destination": "/app-pl.html" },
    { "source": "/nl/play", "destination": "/app-nl.html" },
    { "source": "/nl/play/", "destination": "/app-nl.html" },
    { "source": "/id/play", "destination": "/app-id.html" },
    { "source": "/id/play/", "destination": "/app-id.html" },
    { "source": "/vi/play", "destination": "/app-vi.html" },
    { "source": "/vi/play/", "destination": "/app-vi.html" },
    { "source": "/th/play", "destination": "/app-th.html" },
    { "source": "/th/play/", "destination": "/app-th.html" },
    { "source": "/uk/play", "destination": "/app-uk.html" },
    { "source": "/uk/play/", "destination": "/app-uk.html" },
    { "source": "/ro/play", "destination": "/app-ro.html" },
    { "source": "/ro/play/", "destination": "/app-ro.html" },
    { "source": "/el/play", "destination": "/app-el.html" },
    { "source": "/el/play/", "destination": "/app-el.html" }
  ]
}
