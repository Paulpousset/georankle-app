# typescript
*.tsbuildinfo

# test coverage
coverage/

# editor swap files
*.swp

# generated native folders
/ios
/android
.vercel
.env*

# Captures du playtest multilingue (node scripts/i18n_playtest.mjs)
.playtest-i18n/
